# Copy to .env. Secrets, per-machine URLs, and the values docker compose reads.
#
# Everything tunable lives in bullpen.toml, which is committed. This file is not: it holds only
# what must not be shared or what differs per machine. Variables here win over bullpen.toml.

# Per-deployment.
BULLPEN_APP__ENV=development
BULLPEN_APP__HTTP_ADDR=0.0.0.0:8080

BULLPEN_ENGINE__BASE_URL=http://localhost:8080
BULLPEN_ENGINE__SERVICE_TOKEN=change-me

BULLPEN_DISCORD__TOKEN=
BULLPEN_DISCORD__GUILD_ID=0

# llama-server, OpenAI-compatible. See deploy/inference.
# Shared local AI server instead of the compose `model` profile: if the machine runs
# llama-swap (one OpenAI-compatible endpoint for every local model), point BASE_URL at
# http://127.0.0.1:8100/v1 and set API_KEY to its key. The model name in bullpen.toml is
# served under the same name, so nothing else changes.
BULLPEN_MODEL__BASE_URL=http://localhost:8000/v1
BULLPEN_MODEL__API_KEY=

# Market data. A free key comes from https://finnhub.io/register. Set
# BULLPEN_MARKET__ENABLED=false to run without the market tools.
BULLPEN_MARKET__API_KEY=change-me

# The store service (apps/store) holds conversations, memories, the profile graph and
# confirmations on Postgres. The engine reaches it at STORE__URL; engine and store share
# STORE__TOKEN, at least 16 characters. Compose overrides both URLs for its own network.
BULLPEN_STORE__URL=http://localhost:8090
BULLPEN_STORE__TOKEN=change-me-to-a-long-secret
BULLPEN_STORE__DATABASE_URL=postgres://bullpen:change-me@localhost:5432/bullpen

# A hosted MCP server whose annotations set each tool's risk. Leave unset for none.
# BULLPEN_MCP__HOSTED__URL=http://127.0.0.1:8001/mcp
# BULLPEN_MCP__HOSTED__TOKEN=

BULLPEN_EVALS__ENGINE_URL=http://localhost:8080
BULLPEN_EVALS__ENGINE_SERVICE_TOKEN=change-me

# Read by docker compose and the justfile, not by any app config.
BULLPEN_POSTGRES_PASSWORD=change-me
BULLPEN_CHAT_GGUF=Qwen/Qwen3-4B-GGUF:Q4_K_M
BULLPEN_CHAT_CTX=8192
BULLPEN_CHAT_PARALLEL=2
BULLPEN_CHAT_NGL=99

BULLPEN_GRAFANA_PASSWORD=admin
BULLPEN_IMAGE_TAG=main
# GitHub user or organization whose GHCR images just prod-up pulls, in lower case.
BULLPEN_IMAGE_OWNER=

# Phoenix trace UI (just phoenix). Empty exports no spans there.
BULLPEN_TELEMETRY__PHOENIX_URL=
# Bearer token for a Phoenix that authenticates. Empty sends no Authorization header.
BULLPEN_TELEMETRY__PHOENIX_API_KEY=
# Phoenix URL the compose apps use; http://phoenix:6006 when the phoenix profile runs.
BULLPEN_PHOENIX_URL=
